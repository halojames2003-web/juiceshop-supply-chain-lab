<!DOCTYPE html>
<html>
<head>
<style>
  body { font-family: Arial, sans-serif; margin: 20px; }
  h2 { color: #222; }
  table { border-collapse: collapse; width: 100%; margin-top: 15px; }
  th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
  th { background-color: #f4f4f4; color: #333; }
  .High { background-color: #fff3cd; color: #856404; font-weight: bold; padding: 4px 8px; border-radius: 4px; display: inline-block; }
</style>
</head>
<body>
  <h2>Grype Vulnerability Report</h2>
  <table>
    <tr>
      <th>CVE ID</th>
      <th>GHSA / Original ID</th>
      <th>Severity</th>
      <th>Package</th>
      <th>Installed Version</th>
      <th>Fix Version</th>
    </tr>
    {{- range .Matches}}
    <tr>
      <td><b>{{.Vulnerability.ID}}</b></td>
      <td>
        {{- range .Vulnerability.RelatedVulnerabilities -}}
          {{.ID}}
        {{- else -}}
          N/A
        {{- end -}}
      </td>
      <td><span class="{{.Vulnerability.Severity}}">{{.Vulnerability.Severity}}</span></td>
      <td>{{.Artifact.Name}}</td>
      <td>{{.Artifact.Version}}</td>
      <td>
        {{- range .Vulnerability.Fix.Versions -}}
          {{.}}
        {{- else -}}
          None
        {{- end -}}
      </td>
    </tr>
    {{- end}}
  </table>
</body>
</html>
